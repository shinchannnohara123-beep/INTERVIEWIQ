# InterviewIQ Environment Configuration

# Backend AI Evaluation Service (port 5000)
PORT=5000

# Google Gemini API Key (Optional: If omitted, the high-precision semantic evaluator will run seamlessly in offline/demo mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Optional: If omitted, the app will run with persistent local PostgreSQL engine with full seed data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
